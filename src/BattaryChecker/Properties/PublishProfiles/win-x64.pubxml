<?xml version="1.0" encoding="utf-8"?>
<!-- Release exe: one file, needs the .NET 10 Desktop Runtime.
     dotnet publish src/BattaryChecker -p:PublishProfile=win-x64  →  dist/BattaryChecker.exe -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\dist\</PublishDir>
  </PropertyGroup>
</Project>
