<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Background app with tiny heaps: a background GC thread buys nothing. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Per-monitor DPI awareness. WPF ignores ApplicationHighDpiMode, so the WinForms analyzer's advice
         to move it there (WFO0003) does not apply: WinForms here is only the tray NotifyIcon. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <Version>1.0.1</Version>
    <Product>Battery Checker</Product>
    <AssemblyTitle>Battery Checker</AssemblyTitle>
  </PropertyGroup>

  <!-- WinForms is only for the tray NotifyIcon; keep its names out of WPF code. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
