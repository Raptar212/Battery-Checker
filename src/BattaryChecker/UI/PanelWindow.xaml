<Window x:Class="BattaryChecker.UI.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BattaryChecker.UI"
        Title="Battery Checker" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" Width="400" SizeToContent="Height"
        Deactivated="OnDeactivated" KeyDown="OnKeyDown">
  <Window.Resources>
    <DataTemplate x:Key="Card" DataType="{x:Type ui:DeviceView}">
      <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8"
              Opacity="{Binding Opacity}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="36" Height="36" CornerRadius="6" Background="#33EF4444">
            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                       Foreground="{StaticResource AccentBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="14"
                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource Battery}" />
          <TextBlock Grid.Column="3" Text="{Binding PercentText}" Foreground="{Binding LevelBrush}" FontSize="15"
                     FontWeight="SemiBold" MinWidth="48" TextAlignment="Right" VerticalAlignment="Center" />
          <Button Grid.Column="4" Style="{StaticResource IconButton}" Margin="6,0,0,0" Opacity="{Binding TrayOpacity}"
                  Content="{Binding PinGlyph}" ToolTip="{Binding TrayTip}" Tag="{Binding Id}" Click="OnTray"
                  AutomationProperties.Name="{Binding TrayTip}" />
          <Button Grid.Column="5" Style="{StaticResource IconButton}" Opacity="{Binding EyeOpacity}"
                  ToolTip="{Binding EyeTip}" Tag="{Binding Id}" Click="OnEye"
                  AutomationProperties.Name="{Binding EyeTip}">
            <Grid>
              <TextBlock Text="&#xE890;" />
              <Line X1="1" Y1="1" X2="13" Y2="13" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.4"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding Hidden, Converter={StaticResource BoolToVis}}" />
            </Grid>
          </Button>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="16,14"
          BorderBrush="{StaticResource FrameBrush}" BorderThickness="1">
    <StackPanel>
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="32" Height="32" CornerRadius="6" Background="#33EF4444">
          <TextBlock Text="&#xE83F;" FontFamily="{StaticResource IconFont}" FontSize="15"
                     Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" />
          <TextBlock x:Name="Summary" Foreground="{StaticResource MutedBrush}" FontSize="11" />
        </StackPanel>
        <Button x:Name="SettingsButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE713;"
                Click="OnSettings" />
        <Button x:Name="RefreshButton" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE72C;"
                Click="OnRefresh" />
        <Button x:Name="CloseButton" Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE711;"
                Click="OnClose" />
      </Grid>

      <TextBlock x:Name="ConnectedHeader" Foreground="{StaticResource MutedBrush}" FontSize="11"
                 FontWeight="SemiBold" Margin="2,0,0,8" />
      <ItemsControl x:Name="ConnectedList" ItemTemplate="{StaticResource Card}" />
      <StackPanel x:Name="NoDevices" Margin="2,0,0,8">
        <TextBlock x:Name="NoDevicesTitle" Foreground="{StaticResource TextBrush}" FontSize="12" />
        <TextBlock x:Name="NoDevicesHint" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"
                   TextWrapping="Wrap" />
      </StackPanel>

      <Button x:Name="DisconnectedToggle" Click="OnToggleDisconnected" Cursor="Hand" Margin="0,4,0,8"
              HorizontalAlignment="Left" Foreground="{StaticResource MutedBrush}" FontSize="12">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <ContentPresenter />
          </ControlTemplate>
        </Button.Template>
      </Button>
      <ItemsControl x:Name="DisconnectedList" ItemTemplate="{StaticResource Card}" />
    </StackPanel>
  </Border>
</Window>
