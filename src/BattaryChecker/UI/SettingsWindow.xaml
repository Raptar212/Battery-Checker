<Window x:Class="BattaryChecker.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BattaryChecker.UI"
        Title="Battery Checker" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Width="440" PreviewKeyDown="OnPreviewKeyDown" SizeToContent="Height" WindowStartupLocation="CenterScreen"
        Topmost="True" ShowInTaskbar="True">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,16,0" />
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="8,5">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="Bd" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource FrameBrush}"
                      BorderThickness="1" CornerRadius="6" />
              <ContentPresenter Margin="10,6,28,6" VerticalAlignment="Center" HorizontalAlignment="Left"
                                Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False" />
              <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="0,0,10,0"
                         Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"
                         VerticalAlignment="Center" IsHitTestVisible="False" />
              <ToggleButton Focusable="False" ClickMode="Press" Background="Transparent"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" />
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                     Focusable="False" PopupAnimation="None">
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource FrameBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,2,0,0"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ItemsPresenter />
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MutedBrush}" />
              </Trigger>
              <!-- Tab focus must be visible: the template has no default focus rectangle. -->
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MutedBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Header" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="2,14,0,8" />
    </Style>
    <Style x:Key="MoveButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.3" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="RowButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Bd" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource FrameBrush}"
                      BorderThickness="1" CornerRadius="6" />
              <ContentPresenter Margin="10,7,28,7" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="0,0,10,0"
                         Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"
                         VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MutedBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="16,7">
              <ContentPresenter HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
  <Border x:Name="Main" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="16,14"
          BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1">
    <StackPanel>
      <Grid Background="Transparent" MouseLeftButtonDown="OnHeaderDrag">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="TitleText" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" Click="OnCancel"
                ToolTip="{x:Static ui:Text.Close}" AutomationProperties.Name="{x:Static ui:Text.Close}" />
      </Grid>

      <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="70" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition Height="8" />
          <RowDefinition />
          <RowDefinition Height="8" />
          <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock x:Name="CriticalLabel" Foreground="{DynamicResource TextBrush}" FontSize="13"
                   VerticalAlignment="Center" />
        <TextBox x:Name="CriticalBox" Grid.Column="1" TextAlignment="Right"
                 AutomationProperties.LabeledBy="{Binding ElementName=CriticalLabel}" />
        <TextBlock x:Name="LowLabel" Grid.Row="2" Foreground="{DynamicResource TextBrush}" FontSize="13"
                   VerticalAlignment="Center" />
        <TextBox x:Name="LowBox" Grid.Row="2" Grid.Column="1" TextAlignment="Right"
                 AutomationProperties.LabeledBy="{Binding ElementName=LowLabel}" />
        <TextBlock x:Name="MediumLabel" Grid.Row="4" Foreground="{DynamicResource TextBrush}" FontSize="13"
                   VerticalAlignment="Center" />
        <TextBox x:Name="MediumBox" Grid.Row="4" Grid.Column="1" TextAlignment="Right"
                 AutomationProperties.LabeledBy="{Binding ElementName=MediumLabel}" />
      </Grid>
      <TextBlock x:Name="ThresholdsHint" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="2,6,0,0"
                 TextWrapping="Wrap" />

      <CheckBox x:Name="AutostartBox" Margin="0,14,0,0" />
      <CheckBox x:Name="NotificationsBox" Margin="0,8,0,0" />
      <CheckBox x:Name="BlinkBox" Margin="0,8,0,0" />
      <CheckBox x:Name="DualSenseBox" Margin="0,8,0,0" />
      <TextBlock x:Name="DualSenseHint" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="22,2,0,0"
                 TextWrapping="Wrap" />
      <CheckBox x:Name="UpdatesBox" Margin="0,8,0,0" />

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="TrayHeader" Style="{StaticResource Header}" />
          <ComboBox x:Name="TrayCombo" AutomationProperties.LabeledBy="{Binding ElementName=TrayHeader}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock x:Name="ThemeHeader" Style="{StaticResource Header}" />
          <ComboBox x:Name="ThemeCombo" AutomationProperties.LabeledBy="{Binding ElementName=ThemeHeader}" />
        </StackPanel>
      </Grid>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="FloatingHeader" Style="{StaticResource Header}" />
          <ComboBox x:Name="FloatingCombo" AutomationProperties.LabeledBy="{Binding ElementName=FloatingHeader}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock x:Name="PinnedHeader" Style="{StaticResource Header}" />
          <ComboBox x:Name="PinnedCombo" AutomationProperties.LabeledBy="{Binding ElementName=PinnedHeader}" />
        </StackPanel>
      </Grid>

      <Button x:Name="DevicesButton" Style="{StaticResource RowButton}" Margin="0,14,0,0" Click="OnOpenDevices" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button x:Name="CancelButton" Style="{StaticResource ActionButton}" Background="{DynamicResource CardBrush}"
                Click="OnCancel" IsCancel="True" />
        <Button x:Name="SaveButton" Style="{StaticResource ActionButton}" Background="{DynamicResource AccentBrush}" Foreground="White"
                Margin="8,0,0,0" Click="OnSave" IsDefault="True" />
      </StackPanel>
    </StackPanel>
  </Border>

  <!-- Devices: a card over the whole window; a click on the dimmed area closes it. -->
  <Border x:Name="Overlay" Background="#60000000" CornerRadius="10" Visibility="Collapsed"
          MouseLeftButtonDown="OnOverlayClick">
    <Border Background="{DynamicResource SurfaceSolidBrush}" BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1"
            CornerRadius="10" Padding="16,12" Margin="20" VerticalAlignment="Center">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="OverlayTitle" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <Button x:Name="OverlayClose" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;"
                  Click="OnCloseDevices" />
        </Grid>
        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="64" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="DeviceColumn" Style="{StaticResource Header}" Margin="2,6,0,6" />
          <TextBlock x:Name="OnWidgetColumn" Grid.Column="1" Style="{StaticResource Header}" Margin="0,6,0,6"
                     HorizontalAlignment="Center" />
        </Grid>
        <ScrollViewer x:Name="DeviceScroll" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="DeviceList">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type ui:DeviceSetting}">
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="90" />
                  <ColumnDefinition Width="64" />
                </Grid.ColumnDefinitions>
                <Grid>
                  <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding OwnName}" />
                  <!-- Placeholder: the device's own name, shown while no alias is typed. -->
                  <TextBlock Text="{Binding OwnName}" Foreground="{DynamicResource MutedBrush}" FontSize="13"
                             Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Text, ElementName=NameBox}" Value="">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
                <CheckBox Grid.Column="1" HorizontalAlignment="Center" IsChecked="{Binding OnWidget}"
                          AutomationProperties.Name="{x:Static ui:Text.OnWidget}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button x:Name="UpButton" Style="{StaticResource MoveButton}" Content="&#xE70E;" Width="30" Height="30"
                          IsEnabled="{Binding CanUp}" Click="OnMoveUp" ToolTip="{x:Static ui:Text.MoveUp}"
                          AutomationProperties.Name="{x:Static ui:Text.MoveUp}" />
                  <Button x:Name="DownButton" Style="{StaticResource MoveButton}" Content="&#xE70D;" Width="30" Height="30"
                          IsEnabled="{Binding CanDown}" Click="OnMoveDown" ToolTip="{x:Static ui:Text.MoveDown}"
                          AutomationProperties.Name="{x:Static ui:Text.MoveDown}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Border>
  </Border>
  </Grid>
</Window>
